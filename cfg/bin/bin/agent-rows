#!/usr/bin/env fish
# Usage: agent-rows [WIDTH]
# One fzf row per repository and per Claude agent, laid out like the agent view, as "<cd target>\t<display>".
# On a terminal, only the display, and WIDTH defaults to the terminal's.

set -l cols $argv[1]
set -q cols[1]; or set cols (tput cols)
set -l emit cat
isatty stdout; and set emit cut -f2

set -l agents (claude agents --json --all | string collect)
set -l running (claude agents --json | jq -c 'map(.id)')

# Summaries, update times and worktrees live only in each job's state file
set -l jobs '{}'
set -l states ~/.claude/jobs/*/state.json
set -q states[1]
and set jobs (jq -s 'map(select(.daemonShort) | {key: .daemonShort, value: {detail, createdAt, updatedAt, worktreePath}}) | from_entries' $states | string collect)

set -l live
for dir in (printf '%s' $agents | jq -r --argjson jobs $jobs '.[] | $jobs[.id // ""].worktreePath // .cwd')
    # A merged worktree is deleted while its agent lives on
    test -d $dir; and set -a live $dir
end

if test (count $live) -eq 0
    echo "No Claude agents" >&2
    exit 1
end

set -l pins '[]'
test -f ~/.claude/jobs/pins.json
and set pins (cat ~/.claude/jobs/pins.json | string collect)

set -l order '{}'
set -l orders ~/.claude/jobs/*/order
set -q orders[1]
# Each holds a bare number with no trailing newline, so jq can't read them as one stream
and set order (for f in $orders; printf '%s\t%s\n' (path basename (path dirname $f)) (cat $f); end \
    | jq -nR '[inputs | split("\t") | {key: .[0], value: (.[1] | tonumber? // empty)}] | from_entries' | string collect)

set -l program (path dirname -- (path resolve -- (status filename)))/agent-rows.jq
printf '%s' $agents \
    | jq -r --arg home $HOME --argjson jobs $jobs --argjson running $running --argjson pins $pins --argjson order $order --argjson cols $cols -f $program --args $live \
    | $emit
