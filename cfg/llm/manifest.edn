{:pkg/brew {:sox {} ; voice mode for claude
            ; Other
            :llm {}
            "juxt/allium/allium" {:trust true}
            ; auto_updates cask — self-updating, so syn never reports drift on it
            :t3-code {:dep/requires #{[:pkg/npm "@anthropic-ai/claude-code"]}}}

 :pkg/npm {"@anthropic-ai/claude-code" {:dep/provides #{:claude/marketplace :claude/plugin :claude/mcp}}}

 :pkg/bbin {"clj-paren-repair-claude-hook" {:url "https://github.com/bhauman/clojure-mcp-light.git"
                                            :git/tag "v0.2.0"}
            "clj-nrepl-eval" {:url "https://github.com/bhauman/clojure-mcp-light.git"
                              :git/tag "v0.2.0"
                              :main-opts "[\"-m\" \"clojure-mcp-light.nrepl-eval\"]"}}
 :claude/marketplace {:official {:source "anthropics/claude-plugins-official"}
                      :juxt {:source "juxt/claude-plugins"}
                      :xtdb {:source "xtdb/claude-plugins"}}
 :claude/plugin {:playground {:dep/requires #{[:claude/marketplace :official]}}
                 :allium {:dep/requires #{[:claude/marketplace :juxt]}}
                 :chalk {:dep/requires #{[:claude/marketplace :juxt]}}
                 :chill {:dep/requires #{[:claude/marketplace :juxt]}}
                 :gradle-tests {:dep/requires #{[:claude/marketplace :xtdb]}}}
 :fs/symlink-folder {"~/.claude" "./.claude"}
 ; Skills sit outside ./.claude so the folder walk above cannot reach them: it
 ; links files, and these have to be whole-folder links. That was `sbx skills
 ; import`'s constraint, which has gone with sbx — a folder link covering
 ; ~/.claude/skills would now do, and collapsing this list is a pending tidy.
 ; Until then, one entry per skill: a new skill needs a line here or nothing
 ; links it.
 :fs/symlink {"~/.claude/skills/clojure-eval" "./skills/clojure-eval"
              "~/.claude/skills/compete" "./skills/compete"
              "~/.claude/skills/deliberate" "./skills/deliberate"
              "~/.claude/skills/explain-diff-html" "./skills/explain-diff-html"
              "~/.claude/skills/retrospective" "./skills/retrospective"
              "~/.claude/skills/teach" "./skills/teach"}}
