{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "clj-paren-repair-claude-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "clj-paren-repair-claude-hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clj-paren-repair-claude-hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/osm/.claude/statusline-command.py"
  },
  "enabledPlugins": {
    "playground@claude-plugins-official": true,
    "allium@juxt-plugins": true,
    "chalk@juxt-plugins": true,
    "chill@juxt-plugins": true,
    "gradle-tests@xtdb-plugins": true,
    "swift-lsp@claude-plugins-official": true,
    "a-star@juxt-plugins": true,
    "gd-verity-toolbox@synced": false,
    "gd-cto-toolbox@synced": false,
    "gd-manager-assistant-toolbox@synced": false,
    "gd-risk-toolbox@synced": false,
    "gd-n8n-toolbox@synced": false,
    "gd-people-ops-toolbox@synced": false,
    "gd-tools-toolbox@synced": false,
    "gd-dev-tools-toolbox@synced": false,
    "gd-content-toolbox@synced": false,
    "gd-adr-toolbox@synced": false,
    "gd-sales-analytics-toolbox@synced": false,
    "gd-pursuit-toolbox@synced": false,
    "gd-ir-toolbox@synced": false,
    "gd-account-toolbox@synced": false,
    "gd-dm-toolbox@synced": false,
    "grid@synced": false
  },
  "extraKnownMarketplaces": {
    "juxt-plugins": {
      "source": {
        "source": "github",
        "repo": "juxt/claude-plugins"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "xtdb-plugins": {
      "source": {
        "source": "github",
        "repo": "xtdb/claude-plugins"
      }
    }
  },
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
