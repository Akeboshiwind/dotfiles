{:pkg/mise {:java {:global "temurin-25.0.4+101.0.LTS"
                   :install #{"temurin-21.0.12+101.0.LTS"}}}
 :pkg/script {:java-home {:path "cfg/clojure/java-home.sh"
                          :check "bash cfg/clojure/java-home.sh --check"
                          :dep/requires #{[:complete :pkg/mise]}}}
 :pkg/brew {:clojure {}
            "borkdude/brew/babashka" {:trust true}
            "borkdude/brew/clj-kondo" {:trust true}}
 :fs/symlink-folder {"~/.clojure" "./.clojure"
                     "~/.nrepl" "./.nrepl"
                     "~/.shadow-cljs" "./.shadow-cljs"
                     "~/.config/clojure-lsp" "./.config/clojure-lsp"
                     "~/.gradle/init.d" "./.gradle/init.d"}}
