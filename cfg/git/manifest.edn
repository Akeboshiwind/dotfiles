{:pkg/brew {:git {:dep/provides #{:git}}
            :git-lfs {}
            :lazygit {}
            :gh {}
            :git-crypt {}}
 :pkg/script {:git-crypt-worktrees
              {:path "cfg/git/git-crypt-worktrees.sh"
